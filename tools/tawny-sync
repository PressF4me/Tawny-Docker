#!/usr/bin/env bash
# Refresh app/public/ — the shared web client the image serves — from the
# Tawny Android checkout, which is the source of truth for it (it's the same
# WebView bundle that ships inside the APK).
#
# server.js, docker/, rendezvous/, and package*.json live only in this repo
# now — Tawny Android dropped them (it's APK-only, published separately on
# GitHub) — so this only ever touches app/public/, never the rest of app/.
#
#   bash tools/tawny-sync                 # default source: ../Tawny Android
#   TAWNY_ANDROID=/path/to/repo bash tools/tawny-sync
set -euo pipefail

here="$(cd "$(dirname "$0")/.." && pwd)"
src="${TAWNY_ANDROID:-$here/../Tawny Android}"

if [ ! -d "$src/.git" ]; then
	echo "tawny-sync: no git repo at '$src' — set TAWNY_ANDROID to the Tawny Android checkout" >&2
	exit 1
fi

ref="${1:-HEAD}"

echo "==> syncing app/public/ from $src @ $(git -C "$src" rev-parse --short "$ref") (public)"
rm -rf "$here/app/public"
mkdir -p "$here/app/public"
git -C "$src" archive "$ref" -- public | tar -x -C "$here/app"

# Record provenance so a built image can be traced to a web-client commit.
# Only public/ tracks Android; server.js et al. are this repo's own history.
git -C "$src" rev-parse HEAD > "$here/app/.source-commit"
echo "==> app/public/ now at $(cat "$here/app/.source-commit")"
git -C "$here" status --short app 2>/dev/null || true
