# Secrets — the Tailscale auth key lives here; it is never committed.
.env
*.local

# Vendored payload build artifacts (app/ itself IS tracked — it's the source
# the image builds from — but not these).
**/node_modules/
app/rendezvous/.wrangler/

**/.DS_Store

# Local bug log — not published.
Bugs/

# Local compose hardening — names this machine's tailnet and LAN addresses.
docker-compose.override.yml

# Original chime recordings: not redistributable as loose files (see app/public/sounds/README.md).
app/public/sounds/_src/
